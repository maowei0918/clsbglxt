<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- 允许内网/局域网 HTTP 访问，便于私有化部署；公网建议配 HTTPS -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
