# ============================================================
# clglxt 生产环境配置
# 用法：复制为 .env，逐项填写真实值，切勿提交到版本库
#   cp .env.production.example .env && chmod 600 .env
# ============================================================

# ── 基础 ─────────────────────────────────────────────
CLGLXT_DEBUG=false
CLGLXT_ENABLE_DOCS=false

# ── 数据库（PostgreSQL）────────────────────────────────
# 密码请用 `openssl rand -hex 24` 生成，不要用 changeme
CLGLXT_DATABASE_URL=postgresql+psycopg2://clglxt:CHANGE_ME_DB_PASSWORD@127.0.0.1:5432/clglxt

# 连接池（按并发调：pool_size ≈ gunicorn workers × 2，不超过 PG max_connections）

CLGLXT_DB_POOL_SIZE=20
CLGLXT_DB_MAX_OVERFLOW=10
CLGLXT_DB_POOL_TIMEOUT=30
CLGLXT_DB_POOL_RECYCLE=1800

# ── Redis ────────────────────────────────────────────
CLGLXT_REDIS_URL=redis://127.0.0.1:6379/0
CLGLXT_REDIS_CELERY_URL=redis://127.0.0.1:6379/1

# ── Celery ───────────────────────────────────────────
CLGLXT_CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CLGLXT_CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2
CLGLXT_CELERY_WORKER_CONCURRENCY=4
CLGLXT_CELERY_TASK_TIME_LIMIT=600

# ── 安全 ─────────────────────────────────────────────
# 必填！`openssl rand -hex 32` 生成，长度=64
CLGLXT_JWT_SECRET=CHANGE_ME_64_HEX_CHARS

# access token 有效期（分钟）
CLGLXT_TOKEN_EXPIRE=1440

# 可信反向代理 IP（宝塔 Nginx 通常反代自 127.0.0.1）
CLGLXT_TRUSTED_PROXIES=127.0.0.1

# CORS 允许来源（同源部署留空即可；前后端分离填前端域名）
CLGLXT_CORS_ORIGINS=

# SSRF 白名单（AI/爬虫类出站请求允许的主机，逗号分隔）
CLGLXT_SSRF_ALLOWED_HOSTS=

# ── 上传与存储 ────────────────────────────────────────
CLGLXT_DATA_DIR=/var/www/clglxt/data
CLGLXT_MAX_UPLOAD_MB=20
CLGLXT_MAX_ORDER_UPLOAD_MB=50
CLGLXT_MIN_FREE_MB=512

# ── 审计 ─────────────────────────────────────────────
CLGLXT_AUDIT_RETENTION_DAYS=180
CLGLXT_AUDIT_DEDUP_SECONDS=60

# ── AI ──────────────────────────────────────────────
CLGLXT_AI_DAILY_QUOTA=200

# ── 备份 ─────────────────────────────────────────────
CLGLXT_BACKUP_SKIP_TABLES=audit_logs,login_throttle

# ── 邮件（可选，用于通知/找回密码）─────────────────────
CLGLXT_SMTP_HOST=
CLGLXT_SMTP_PORT=465
CLGLXT_SMTP_USER=
CLGLXT_SMTP_PASS=
CLGLXT_SMTP_FROM=
