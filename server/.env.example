# ============================================================
# clglxt 环境变量示例（复制为 .env 后修改）
# 全部变量均可留空使用默认值；安装向导会自动写入关键几项。
# ============================================================

# ── 应用 ──
CLGLXT_APP_TITLE=clglxt 车辆管理系统
CLGLXT_ENABLE_DOCS=false
CLGLXT_DEBUG=false
CLGLXT_DATA_DIR=./data

# ── 数据库（PostgreSQL） ──
CLGLXT_DATABASE_URL=postgresql+psycopg2://clglxt:changeme@127.0.0.1:5432/clglxt
CLGLXT_DB_POOL_SIZE=15
CLGLXT_DB_MAX_OVERFLOW=20
CLGLXT_DB_POOL_TIMEOUT=30
CLGLXT_DB_POOL_RECYCLE=3600

# ── Redis ──
CLGLXT_REDIS_URL=redis://127.0.0.1:6379/0
CLGLXT_REDIS_CELERY_URL=redis://127.0.0.1:6379/1

# ── Celery ──
CLGLXT_CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CLGLXT_CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
CLGLXT_CELERY_WORKER_CONCURRENCY=4
CLGLXT_CELERY_TASK_TIME_LIMIT=3600

# ── 认证 ──
# 必须替换！占位符/示例值会导致应用拒绝启动（已安装状态）。
# 生成：openssl rand -hex 32
CLGLXT_JWT_SECRET=CHANGE_ME_run_openssl_rand_hex_32
CLGLXT_TOKEN_EXPIRE=1440

# ── 安全 ──
CLGLXT_CORS_ORIGINS=
CLGLXT_TRUSTED_PROXIES=127.0.0.1,::1

# ── 上传/图片 ──
CLGLXT_MAX_UPLOAD_MB=20
CLGLXT_MAX_ORDER_UPLOAD_MB=200
CLGLXT_MIN_FREE_MB=1024
CLGLXT_IMAGE_MAX_DIM=1920
CLGLXT_IMAGE_QUALITY=78
CLGLXT_IMAGE_FMT=JPEG

# ── 审计 ──
CLGLXT_AUDIT_RETENTION_DAYS=180
CLGLXT_AUDIT_DEDUP_SECONDS=60

# ── AI ──
CLGLXT_AI_DAILY_QUOTA=20

# ── 备份 ──
CLGLXT_BACKUP_SKIP_TABLES=

# ── 邮箱（可选，配置后启用邮件通知） ──
CLGLXT_SMTP_HOST=
CLGLXT_SMTP_PORT=587
CLGLXT_SMTP_USER=
CLGLXT_SMTP_PASS=
CLGLXT_SMTP_FROM=

# ── 出站白名单（SSRF 防护，逗号分隔） ──
CLGLXT_SSRF_ALLOWED_HOSTS=

# ── FMS 数据导入（一次性迁移，FMS 停机前实施；详见 docs/fms-migration.md） ──
# 老 FMS 只读开放接口基址，host 必须同时加入上面的 CLGLXT_SSRF_ALLOWED_HOSTS
CLGLXT_FMS_BASE_URL=
# FMS 开放接口密钥（fms_ 开头，需 vehicles/repairs/vehicle_use/daily_check/contracts 的 :read）
CLGLXT_FMS_API_KEY=
CLGLXT_FMS_PAGE_SIZE=200
CLGLXT_FMS_TIMEOUT=30
CLGLXT_FMS_MAX_RETRIES=3
